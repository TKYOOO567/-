<%- include('partials/header') %>

<style>
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes float {
    0%, 100% { transform: translateY(-6px); }
    50% { transform: translateY(-2px); }
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }
  .stat-card {
    background: var(--bg-card, rgba(17, 24, 39, 0.85));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-color, rgba(0, 212, 255, 0.15));
    border-radius: 12px;
    padding: 28px 24px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.35s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.35s ease;
    display: block;
    position: relative;
    overflow: hidden;
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .stat-card:nth-child(1) { animation-delay: 0.05s; }
  .stat-card:nth-child(2) { animation-delay: 0.12s; }
  .stat-card:nth-child(3) { animation-delay: 0.19s; }
  .stat-card:nth-child(4) { animation-delay: 0.26s; }
  .stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.3), transparent);
  }
  .stat-card:hover {
    transform: translateY(-6px);
    animation: float 2.5s ease-in-out infinite;
  }
  .stat-card.accent-1:hover {
    box-shadow: 0 0 30px rgba(0, 212, 255, 0.25), 0 8px 32px rgba(0, 0, 0, 0.5);
    border-color: rgba(0, 212, 255, 0.4);
  }
  .stat-card.accent-2:hover {
    box-shadow: 0 0 30px rgba(59, 130, 246, 0.25), 0 8px 32px rgba(0, 0, 0, 0.5);
    border-color: rgba(59, 130, 246, 0.4);
  }
  .stat-card.accent-3:hover {
    box-shadow: 0 0 30px rgba(239, 68, 68, 0.25), 0 8px 32px rgba(0, 0, 0, 0.5);
    border-color: rgba(239, 68, 68, 0.4);
  }
  .stat-card.accent-4:hover {
    box-shadow: 0 0 30px rgba(245, 158, 11, 0.25), 0 8px 32px rgba(0, 0, 0, 0.5);
    border-color: rgba(245, 158, 11, 0.4);
  }
  .stat-card .icon {
    font-size: 2.4em;
    margin-bottom: 10px;
    filter: drop-shadow(0 0 6px rgba(0, 212, 255, 0.3));
  }
  .stat-card .label {
    font-size: 0.9em;
    color: var(--text-secondary, #94a3b8);
    margin-bottom: 6px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .stat-card .value {
    font-size: 2.2em;
    font-weight: bold;
    color: var(--text-primary, #e2e8f0);
    text-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
  }
  .stat-card .value span {
    color: var(--text-muted, #64748b) !important;
    text-shadow: none;
  }
  .stat-card.accent-1 { border-top: 3px solid #00d4ff; }
  .stat-card.accent-2 { border-top: 3px solid #3b82f6; }
  .stat-card.accent-3 { border-top: 3px solid #ef4444; }
  .stat-card.accent-4 { border-top: 3px solid #f59e0b; }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 10px;
  }
  .feature-item {
    background: var(--bg-card, rgba(17, 24, 39, 0.85));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-color, rgba(0, 212, 255, 0.15));
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    border-left: 3px solid #00d4ff;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s ease;
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .feature-item:nth-child(1) { animation-delay: 0.30s; }
  .feature-item:nth-child(2) { animation-delay: 0.37s; }
  .feature-item:nth-child(3) { animation-delay: 0.44s; }
  .feature-item:nth-child(4) { animation-delay: 0.51s; }
  .feature-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 25px rgba(0, 212, 255, 0.15), 0 8px 24px rgba(0, 0, 0, 0.4);
    border-color: rgba(0, 212, 255, 0.35);
    border-left-color: #00d4ff;
  }
  .feature-item .title {
    font-weight: bold;
    font-size: 1.05em;
    color: var(--text-primary, #e2e8f0);
    margin-bottom: 6px;
  }
  .feature-item .desc {
    font-size: 0.9em;
    color: var(--text-secondary, #94a3b8);
  }
</style>

<div class="container">
  <h1>仪表盘</h1>

  <div class="stats-grid">
    <a href="/config" class="stat-card accent-1">
      <div class="icon">&#x1f3ed;</div>
      <div class="label">仓库区域</div>
      <div class="value"><%= zoneCount %> <span style="font-size:0.5em;color:var(--text-muted,#64748b);">个</span></div>
    </a>
    <a href="/products" class="stat-card accent-2">
      <div class="icon">&#x1f4e6;</div>
      <div class="label">在库商品</div>
      <div class="value"><%= inStockCount %> <span style="font-size:0.5em;color:var(--text-muted,#64748b);">件</span></div>
    </a>
    <a href="/products?status=out" class="stat-card accent-3">
      <div class="icon">&#x1f69a;</div>
      <div class="label">已出库</div>
      <div class="value"><%= outStockCount %> <span style="font-size:0.5em;color:var(--text-muted,#64748b);">件</span></div>
    </a>
    <a href="/warehouse" class="stat-card accent-4">
      <div class="icon">&#x1f5fa;&#xfe0f;</div>
      <div class="label">3D仓库图</div>
      <div class="value" style="font-size:1.5em;">查看</div>
    </a>
  </div>

  <div class="card">
    <h2>功能概览</h2>
    <div class="features">
      <div class="feature-item">
        <div class="title">&#x1f4e5; 商品入库</div>
        <div class="desc">记录新商品信息并自动生成唯一编码</div>
      </div>
      <div class="feature-item">
        <div class="title">&#x1f4e4; 商品出库</div>
        <div class="desc">快速处理出库操作，历史记录可查</div>
      </div>
      <div class="feature-item">
        <div class="title">&#x1f50d; 商品查询</div>
        <div class="desc">多维度搜索，精确定位商品位置</div>
      </div>
      <div class="feature-item">
        <div class="title">&#x1f30d; 3D可视化</div>
        <div class="desc">三维立体展示仓库布局和商品分布</div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
