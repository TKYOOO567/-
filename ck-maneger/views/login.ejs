<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>仓储管理系统</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideLeft {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes glowPulse {
      0%, 100% { 
        text-shadow: 0 0 10px rgba(0, 212, 255, 0.3), 0 0 30px rgba(0, 212, 255, 0.2), 0 0 60px rgba(0, 212, 255, 0.15);
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.2), 0 0 40px rgba(0, 212, 255, 0.1), inset 0 0 60px rgba(0, 212, 255, 0.08);
      }
      50% { 
        text-shadow: 0 0 15px rgba(0, 212, 255, 0.4), 0 0 40px rgba(0, 212, 255, 0.25), 0 0 80px rgba(0, 212, 255, 0.2);
        box-shadow: 0 0 30px rgba(0, 212, 255, 0.25), 0 0 60px rgba(0, 212, 255, 0.15), inset 0 0 80px rgba(0, 212, 255, 0.1);
      }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      margin: 0;
      overflow-x: hidden;
    }

    .login-wrapper {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      background: linear-gradient(135deg, #0a0e1a 0%, #0d1528 50%, #0a1020 100%);
      overflow: hidden;
    }

    .login-bg-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        radial-gradient(ellipse at 15% 30%, rgba(0, 212, 255, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse at 85% 70%, rgba(0, 153, 170, 0.06) 0%, transparent 50%),
        linear-gradient(180deg, rgba(10, 14, 26, 0.85) 0%, rgba(10, 14, 26, 0.95) 100%);
      z-index: 1;
    }

    .tech-pattern {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        linear-gradient(rgba(0, 212, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1px, transparent 1px);
      background-size: 50px 50px;
      z-index: 1;
      pointer-events: none;
    }

    .tech-line {
      position: absolute;
      width: 2px;
      height: 100%;
      background: linear-gradient(180deg, transparent 0%, rgba(0, 212, 255, 0.3) 50%, transparent 100%);
      z-index: 1;
      pointer-events: none;
    }

    .tech-line:nth-child(1) { left: 10%; }
    .tech-line:nth-child(2) { left: 30%; }
    .tech-line:nth-child(3) { left: 70%; }
    .tech-line:nth-child(4) { left: 90%; }

    .tech-particle {
      position: absolute;
      width: 4px;
      height: 4px;
      background: #00d4ff;
      border-radius: 50%;
      box-shadow: 0 0 10px #00d4ff, 0 0 20px #00d4ff;
      animation: float 3s ease-in-out infinite;
      z-index: 1;
      pointer-events: none;
    }

    .tech-particle:nth-child(5) { top: 20%; left: 20%; animation-delay: 0s; }
    .tech-particle:nth-child(6) { top: 60%; left: 15%; animation-delay: 0.5s; }
    .tech-particle:nth-child(7) { top: 40%; left: 85%; animation-delay: 1s; }
    .tech-particle:nth-child(8) { top: 80%; left: 80%; animation-delay: 1.5s; }

    .login-header {
      position: relative;
      z-index: 10;
      padding: 20px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      animation: fadeIn 0.8s ease-out;
    }

    .login-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .login-logo-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #00d4ff 0%, #0066aa 100%);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 20px rgba(0, 212, 255, 0.4), 0 4px 12px rgba(0, 0, 0, 0.3);
    }

    .login-logo-icon svg {
      width: 24px;
      height: 24px;
      fill: #fff;
    }

    .login-logo-text {
      font-size: 1.3rem;
      font-weight: 700;
      color: #fff;
      letter-spacing: 1px;
      text-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
    }

    .login-nav {
      display: flex;
      gap: 24px;
    }

    .login-nav-link {
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.3s, text-shadow 0.3s;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .login-nav-link:hover {
      color: #00d4ff;
      text-shadow: 0 0 8px rgba(0, 212, 255, 0.4);
    }

    .login-nav-link svg {
      width: 16px;
      height: 16px;
    }

    .login-top-right-tag {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 212, 255, 0.1);
      padding: 6px 14px;
      border-radius: 20px;
      border: 1px solid rgba(0, 212, 255, 0.2);
    }

    .login-top-right-tag span {
      color: #00d4ff;
      font-size: 0.85rem;
      font-weight: 500;
    }

    .login-top-right-tag .divider {
      width: 1px;
      height: 14px;
      background: rgba(0, 212, 255, 0.3);
    }

    .login-main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px;
      gap: 60px;
      position: relative;
      z-index: 10;
    }

    .login-left-panel {
      flex: 0 0 auto;
      width: 380px;
      animation: slideUp 0.9s ease-out 0.1s both;
    }

    .data-card {
      background: rgba(10, 20, 30, 0.75);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(0, 212, 255, 0.15);
      border-radius: 14px;
      padding: 24px;
      margin-bottom: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35), 0 0 20px rgba(0, 212, 255, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .data-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45), 0 0 30px rgba(0, 212, 255, 0.1);
    }

    .data-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .data-card-title {
      font-size: 0.9rem;
      color: #94a3b8;
      font-weight: 500;
    }

    .data-card-icon {
      width: 32px;
      height: 32px;
      background: rgba(0, 212, 255, 0.1);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .data-card-icon svg {
      width: 18px;
      height: 18px;
      fill: #00d4ff;
    }

    .data-card-value {
      font-size: 2.5rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
      text-shadow: 0 0 20px rgba(0, 212, 255, 0.25);
    }

    .data-card-sub {
      font-size: 0.85rem;
      color: #64748b;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .data-card-trend {
      color: #10b981;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .data-card-trend svg {
      width: 14px;
      height: 14px;
      fill: #10b981;
    }

    .data-card-chart {
      display: flex;
      gap: 6px;
      margin-top: 16px;
      align-items: flex-end;
      height: 50px;
    }

    .chart-bar {
      flex: 1;
      background: linear-gradient(180deg, rgba(0, 212, 255, 0.4) 0%, rgba(0, 212, 255, 0.1) 100%);
      border-radius: 4px 4px 0 0;
      min-height: 10px;
      transition: height 0.3s;
    }

    .chart-bar:nth-child(1) { height: 30%; }
    .chart-bar:nth-child(2) { height: 50%; }
    .chart-bar:nth-child(3) { height: 40%; }
    .chart-bar:nth-child(4) { height: 70%; }
    .chart-bar:nth-child(5) { height: 60%; }
    .chart-bar:nth-child(6) { height: 85%; }
    .chart-bar:nth-child(7) { height: 100%; }

    .circular-progress {
      position: relative;
      width: 70px;
      height: 70px;
      margin-top: 8px;
    }

    .circular-progress svg {
      width: 70px;
      height: 70px;
      transform: rotate(-90deg);
    }

    .circular-progress .bg {
      fill: none;
      stroke: rgba(0, 212, 255, 0.1);
      stroke-width: 6;
    }

    .circular-progress .progress {
      fill: none;
      stroke: #00d4ff;
      stroke-width: 6;
      stroke-linecap: round;
      stroke-dasharray: 188.495;
      stroke-dashoffset: 37.699;
      filter: drop-shadow(0 0 6px rgba(0, 212, 255, 0.5));
    }

    .circular-progress .center {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
    }

    .circular-progress .center .value {
      font-size: 1rem;
      font-weight: 700;
      color: #fff;
    }

    .circular-progress .center .label {
      font-size: 0.6rem;
      color: #64748b;
      margin-top: 2px;
    }

    .login-right-panel {
      flex: 0 0 auto;
      width: 520px;
      animation: slideLeft 0.9s ease-out 0.2s both;
    }

    .login-card {
      width: 100%;
      background: rgba(10, 20, 30, 0.7);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(0, 212, 255, 0.2);
      border-radius: 20px;
      padding: 48px 44px 44px;
      box-shadow:
        0 0 60px rgba(0, 212, 255, 0.08),
        0 12px 48px rgba(0, 0, 0, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
      position: relative;
      overflow: hidden;
    }

    .login-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #00d4ff, transparent);
      box-shadow: 0 0 20px rgba(0, 212, 255, 0.4);
    }

    .login-card-logo {
      text-align: center;
      margin-bottom: 8px;
    }

    .login-card-logo-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #00d4ff 0%, #0066aa 50%, #00d4ff 100%);
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 40px rgba(0, 212, 255, 0.35), 0 8px 24px rgba(0, 0, 0, 0.4);
      margin-bottom: 16px;
      animation: glowPulse 3s ease-in-out infinite;
    }

    .login-card-logo-icon svg {
      width: 44px;
      height: 44px;
      fill: #0a0e1a;
    }

    .login-title {
      text-align: center;
      margin-bottom: 4px;
      font-size: 2.1rem;
      font-weight: 700;
      color: #fff;
      letter-spacing: 4px;
      text-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
    }

    .login-subtitle {
      text-align: center;
      margin-bottom: 8px;
      font-size: 0.95rem;
      color: #94a3b8;
      letter-spacing: 2px;
      font-weight: 300;
    }

    .login-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 28px;
      gap: 12px;
    }

    .login-divider-line {
      width: 60px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.4), transparent);
    }

    .login-divider-text {
      color: #64748b;
      font-size: 0.8rem;
      letter-spacing: 1px;
    }

    .login-card .form-group {
      margin-bottom: 22px;
      position: relative;
    }

    .login-card .form-group label {
      display: block;
      margin-bottom: 8px;
      color: #94a3b8;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
    }

    .input-wrapper {
      position: relative;
    }

    .input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 20px;
      height: 20px;
      fill: #64748b;
      transition: fill 0.3s;
      z-index: 2;
    }

    .login-card input[type="text"],
    .login-card input[type="password"] {
      width: 100%;
      padding: 13px 16px 13px 44px;
      background: rgba(10, 15, 25, 0.85);
      border: 1px solid rgba(0, 212, 255, 0.18);
      border-radius: 10px;
      color: #e2e8f0;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
      box-sizing: border-box;
    }

    .login-card input[type="text"]:focus,
    .login-card input[type="password"]:focus {
      border-color: #00d4ff;
      background: rgba(10, 15, 25, 0.95);
      box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1), 0 0 20px rgba(0, 212, 255, 0.15);
    }

    .login-card input[type="text"]:focus ~ .input-icon,
    .login-card input[type="password"]:focus ~ .input-icon {
      fill: #00d4ff;
    }

    .login-card input[type="text"]::placeholder,
    .login-card input[type="password"]::placeholder {
      color: #475569;
      opacity: 1;
    }

    .password-toggle {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 20px;
      height: 20px;
      fill: #64748b;
      cursor: pointer;
      transition: fill 0.3s;
      z-index: 2;
    }

    .password-toggle:hover {
      fill: #00d4ff;
    }

    .login-card .btn-primary {
      width: 100%;
      padding: 14px;
      margin-top: 8px;
      background: linear-gradient(135deg, #00d4ff 0%, #0077aa 50%, #00d4ff 100%);
      background-size: 200% 100%;
      color: #0a0e1a;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 4px;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: box-shadow 0.3s, transform 0.15s, background-position 0.5s;
      box-shadow: 0 0 20px rgba(0, 212, 255, 0.3), 0 4px 12px rgba(0, 0, 0, 0.3);
      position: relative;
      overflow: hidden;
    }

    .login-card .btn-primary::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.5s;
    }

    .login-card .btn-primary:hover {
      background-position: 100% 0;
      box-shadow: 0 0 30px rgba(0, 212, 255, 0.45), 0 6px 20px rgba(0, 0, 0, 0.4);
      transform: translateY(-2px);
    }

    .login-card .btn-primary:hover::before {
      left: 100%;
    }

    .login-card .btn-primary:active {
      transform: translateY(0);
      box-shadow: 0 0 15px rgba(0, 212, 255, 0.35);
    }

    .login-footer-links {
      display: flex;
      justify-content: space-between;
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid rgba(0, 212, 255, 0.1);
    }

    .login-footer-link {
      color: #64748b;
      text-decoration: none;
      font-size: 0.85rem;
      transition: color 0.3s;
      cursor: pointer;
    }

    .login-footer-link:hover {
      color: #00d4ff;
    }

    .login-alert {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #f87171;
      border-radius: 10px;
      padding: 12px 16px;
      margin-bottom: 20px;
      font-size: 0.88rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .login-alert-icon {
      width: 18px;
      height: 18px;
      fill: #f87171;
      flex-shrink: 0;
    }

    .login-bottom {
      position: relative;
      z-index: 10;
      padding: 24px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      animation: fadeIn 0.8s ease-out 0.4s both;
    }

    .login-copyright {
      color: #475569;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .login-copyright-icon {
      width: 16px;
      height: 16px;
      fill: #64748b;
    }

    .login-bottom-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .login-bottom-tag {
      background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(0, 119, 170, 0.1) 100%);
      padding: 8px 18px;
      border-radius: 24px;
      border: 1px solid rgba(0, 212, 255, 0.25);
      box-shadow: 0 0 20px rgba(0, 212, 255, 0.1);
    }

    .login-bottom-tag span {
      color: #00d4ff;
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 1px;
    }

    .login-bottom-tag .dot {
      display: inline-block;
      width: 4px;
      height: 4px;
      background: #00d4ff;
      border-radius: 50%;
      margin: 0 6px;
      box-shadow: 0 0 6px #00d4ff;
    }

    @media (max-width: 1024px) {
      .login-main {
        flex-direction: column;
        padding: 30px 20px;
      }
      .login-left-panel {
        max-width: 100%;
        width: 100%;
      }
      .login-right-panel {
        width: 100%;
        max-width: 480px;
      }
      .login-header {
        padding: 16px 20px;
      }
      .login-bottom {
        padding: 16px 20px;
      }
      .login-nav {
        display: none;
      }
    }

    @media (max-width: 640px) {
      .login-card {
        padding: 36px 24px 28px;
        border-radius: 16px;
      }
      .login-title {
        font-size: 1.7rem;
      }
      .data-card {
        padding: 18px;
      }
      .login-top-right-tag {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="login-wrapper">
    <div class="login-bg-overlay"></div>
    <div class="tech-pattern"></div>
    <div class="tech-line"></div>
    <div class="tech-line"></div>
    <div class="tech-line"></div>
    <div class="tech-line"></div>
    <div class="tech-particle"></div>
    <div class="tech-particle"></div>
    <div class="tech-particle"></div>
    <div class="tech-particle"></div>

    <header class="login-header">
      <div class="login-logo">
        <div class="login-logo-icon">
          <svg viewBox="0 0 24 24">
            <path d="M4 5c0-1.1.9-2 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5zm2 0v14h12V5H6zm2 2h8v2H8V7zm0 4h8v2H8v-2zm0 4h6v2H8v-2z"/>
          </svg>
        </div>
        <span class="login-logo-text">仓储管理系统</span>
      </div>
      <nav class="login-nav">
        <a class="login-nav-link">
          <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12h7zm-7 0h7V5.99l-7 3.14v5.86z"/></svg>
          数据安全
        </a>
        <a class="login-nav-link">
          <svg viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM10 17l-3.5-3.5 1.41-1.41L10 14.17l4.59-4.59L16 11l-6 6z"/></svg>
          云端部署
        </a>
        <a class="login-nav-link">
          <svg viewBox="0 0 24 24"><path d="M21 8V7l-3 2-3-2v1l3 2 3-2zm1-5H2C.9 3 0 3.9 0 5v14c0 1.1.9 2 2 2h20c1.1 0 1.99-.9 1.99-2L24 5c0-1.1-.9-2-2-2zM8 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H2v-1c0-2 4-3.1 6-3.1s6 1.1 6 3.1v1zm8-6h-8V6h8v6z"/></svg>
          智能分析
        </a>
      </nav>
      <div class="login-top-right-tag">
        <span>高效</span>
        <div class="divider"></div>
        <span>智能</span>
        <div class="divider"></div>
        <span>可靠</span>
      </div>
    </header>

    <main class="login-main">
      <div class="login-left-panel">
        <div class="data-card">
          <div class="data-card-header">
            <span class="data-card-title">今日入库</span>
            <div class="data-card-icon">
              <svg viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
              </svg>
            </div>
          </div>
          <div class="data-card-value">1,268</div>
          <div class="data-card-sub">
            <span>较昨日</span>
            <span class="data-card-trend">
              <svg viewBox="0 0 24 24"><path d="M7 14l5-5 5 5H7z"/></svg>
              +12.3%
            </span>
          </div>
          <div class="data-card-chart">
            <div class="chart-bar"></div>
            <div class="chart-bar"></div>
            <div class="chart-bar"></div>
            <div class="chart-bar"></div>
            <div class="chart-bar"></div>
            <div class="chart-bar"></div>
            <div class="chart-bar"></div>
          </div>
        </div>

        <div class="data-card">
          <div class="data-card-header">
            <span class="data-card-title">库存准确率</span>
            <div class="data-card-icon">
              <svg viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
          </div>
          <div class="circular-progress">
            <svg viewBox="0 0 72 72">
              <circle class="bg" cx="36" cy="36" r="30"/>
              <circle class="progress" cx="36" cy="36" r="30"/>
            </svg>
            <div class="center">
              <div class="value">99.8%</div>
              <div class="label">准确率</div>
            </div>
          </div>
          <div class="data-card-sub">
            <span>较昨日</span>
            <span class="data-card-trend">
              <svg viewBox="0 0 24 24"><path d="M7 14l5-5 5 5H7z"/></svg>
              +0.3%
            </span>
          </div>
        </div>
      </div>

      <div class="login-right-panel">
        <div class="login-card">
          <div class="login-card-logo">
            <div class="login-card-logo-icon">
              <svg viewBox="0 0 24 24">
                <path d="M4 5c0-1.1.9-2 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5zm2 0v14h12V5H6zm2 2h8v2H8V7zm0 4h8v2H8v-2zm0 4h6v2H8v-2z"/>
              </svg>
            </div>
            <h2 class="login-title">仓储管理系统</h2>
            <p class="login-subtitle">智能仓储 · 高效管理 · 数据驱动</p>
            <div class="login-divider">
              <div class="login-divider-line"></div>
              <span class="login-divider-text">LOGIN</span>
              <div class="login-divider-line"></div>
            </div>
          </div>

          <% if (error) { %>
          <div class="login-alert">
            <svg class="login-alert-icon" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
            <%= error %>
          </div>
          <% } %>

          <form method="post" action="/login">
            <div class="form-group">
              <label for="username">用户名</label>
              <div class="input-wrapper">
                <input type="text" id="username" name="username" required placeholder="请输入用户名">
                <svg class="input-icon" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              </div>
            </div>
            <div class="form-group">
              <label for="password">密码</label>
              <div class="input-wrapper">
                <input type="password" id="password" name="password" required placeholder="请输入密码">
                <svg class="input-icon" viewBox="0 0 24 24">
                  <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                </svg>
                <svg class="password-toggle" viewBox="0 0 24 24">
                  <path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75 1.37-2.97 1.37-6.31 0-9.28C19.39 1.22 15.82 0 12 0 8.5 0 5.37 1.28 3.07 3.4l2.92 2.92C10.74 6.13 11.35 6 12 6v1zm0 3c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM1 21l2.28-2.28C2.01 17.93 1 15.04 1 12c0-2.59.79-4.98 2.15-6.99L3 5.73 4.73 4l1.27 1.27C7.54 4.48 9.69 4 12 4c2.25 0 4.33.7 6 1.88L18.27 5l1.27-1.27L21 5l-2 2L19.3 6.7l2.28 2.28c1.37 2.01 2.15 4.4 2.15 6.99 0 2.97-.74 5.79-2.03 8.27L22 23l-1.27-1.27L18 21l-2 2-2-2-2 2-2-2-2 2-2-2-2 2-2-2 2-2-2-2zm2-9c0 1.84.52 3.55 1.43 5.04l3.31-3.31C9.28 15.56 9 14.82 9 14c0-1.1.9-2 2-2s2 .9 2 2c0 .82-.28 1.56-.73 2.14l3.31 3.31C15.45 18.52 17.16 18 19 18c1.35 0 2.62.32 3.75.88l-1.87-1.87C19.96 16.28 20 15.14 20 14c0-1.84-.52-3.55-1.43-5.04l-3.31 3.31C14.72 12.44 15 13.18 15 14c0 1.1-.9 2-2 2s-2-.9-2-2c0-.82.28-1.56.73-2.14l-3.31-3.31C8.04 9.72 8 10.86 8 12c0 .34.02.68.05 1.01l-1.58 1.58C6.32 13.45 6 12.75 6 12z"/>
                </svg>
              </div>
            </div>
            <button type="submit" class="btn btn-primary">登录</button>
          </form>

          <div class="login-footer-links">
            <a class="login-footer-link">忘记密码？</a>
            <div class="login-footer-divider"></div>
            <a class="login-footer-link">系统帮助</a>
          </div>
        </div>
      </div>
    </main>

    <footer class="login-bottom">
      <div class="login-copyright">
        <svg class="login-copyright-icon" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-.22-13h-.06c-.4 0-.72.32-.72.72v4.11c0 .39.32.71.72.71h4.11c.4 0 .72-.32.72-.72v-.06c0-.39-.32-.71-.72-.71h-2.44v-2.5h2.44c.4 0 .72-.32.72-.72V7.72c0-.39-.32-.71-.72-.71z"/>
        </svg>
        © 2026 仓储管理系统 版权所有
      </div>
      <div class="login-bottom-right">
        <div class="login-bottom-tag">
          <span>高效</span>
          <span class="dot"></span>
          <span>智能</span>
          <span class="dot"></span>
          <span>可靠</span>
        </div>
      </div>
    </footer>
  </div>

  <script>
    (function() {
      const passwordInput = document.getElementById('password');
      const passwordToggle = document.querySelector('.password-toggle');
      if (passwordInput && passwordToggle) {
        passwordToggle.addEventListener('click', function() {
          const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
          passwordInput.setAttribute('type', type);
          passwordToggle.innerHTML = type === 'password'
            ? '<path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75 1.37-2.97 1.37-6.31 0-9.28C19.39 1.22 15.82 0 12 0 8.5 0 5.37 1.28 3.07 3.4l2.92 2.92C10.74 6.13 11.35 6 12 6v1zm0 3c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM1 21l2.28-2.28C2.01 17.93 1 15.04 1 12c0-2.59.79-4.98 2.15-6.99L3 5.73 4.73 4l1.27 1.27C7.54 4.48 9.69 4 12 4c2.25 0 4.33.7 6 1.88L18.27 5l1.27-1.27L21 5l-2 2L19.3 6.7l2.28 2.28c1.37 2.01 2.15 4.4 2.15 6.99 0 2.97-.74 5.79-2.03 8.27L22 23l-1.27-1.27L18 21l-2 2-2-2-2 2-2-2-2 2-2-2 2-2-2-2zm2-9c0 1.84.52 3.55 1.43 5.04l3.31-3.31C9.28 15.56 9 14.82 9 14c0-1.1.9-2 2-2s2 .9 2 2c0 .82-.28 1.56-.73 2.14l3.31 3.31C14.72 12.44 15 13.18 15 14c0 1.1-.9 2-2 2s-2-.9-2-2c0-.82.28-1.56.73-2.14l-3.31-3.31C8.04 9.72 8 10.86 8 12c0 .34.02.68.05 1.01l-1.58 1.58C6.32 13.45 6 12.75 6 12z"/>'
            : '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
        });
      }
    })();
  </script>
</body>
</html>
