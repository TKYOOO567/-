<%- include('partials/header') %>

<style>
@keyframes cardSlideIn {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card {
  animation: cardSlideIn 0.5s ease-out both;
}

.card:nth-child(2) {
  animation-delay: 0.12s;
}

.card:nth-child(3) {
  animation-delay: 0.24s;
}

.zone-input {
  min-width: 60px;
  padding: 4px 6px;
  font-size: 0.82rem;
  background: var(--bg-input);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
  border-radius: 4px;
  text-align: center;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.zone-input[name="cell_width"],
.zone-input[name="cell_height"],
.zone-input[name="cell_depth"] {
  min-width: 68px;
}

.zone-input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 6px var(--accent-glow);
}

.zone-input::-webkit-inner-spin-button,
.zone-input::-webkit-outer-spin-button {
  opacity: 1;
  height: 16px;
}

td strong {
  color: var(--accent);
  text-shadow: 0 0 8px var(--accent-glow);
  letter-spacing: 0.5px;
}

.save-zone-btn {
  padding: 4px 12px;
  font-size: 0.78rem;
  border-radius: 4px;
  white-space: nowrap;
}
</style>

<div class="container">
  <h1>仓库配置</h1>

  <div id="alertArea"></div>

  <div class="card">
    <h2>仓库整体尺寸</h2>
    <form id="warehouseSizeForm">
      <div class="form-row">
        <div class="form-group">
          <label for="warehouse_width">仓库宽度 (m)</label>
          <input type="number" id="warehouse_width" name="warehouse_width" step="0.1" value="<%= configs.warehouse_width || '' %>" required>
        </div>
        <div class="form-group">
          <label for="warehouse_height">仓库高度 (m)</label>
          <input type="number" id="warehouse_height" name="warehouse_height" step="0.1" value="<%= configs.warehouse_height || '' %>" required>
        </div>
        <div class="form-group">
          <label for="warehouse_depth">仓库深度 (m)</label>
          <input type="number" id="warehouse_depth" name="warehouse_depth" step="0.1" value="<%= configs.warehouse_depth || '' %>" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="exit_pos_x">出口位置 X (米)</label>
          <input type="number" id="exit_pos_x" name="exit_pos_x" step="0.1" value="<%= exitPosX %>" class="form-control">
        </div>
        <div class="form-group">
          <label for="exit_pos_z">出口位置 Z (米)</label>
          <input type="number" id="exit_pos_z" name="exit_pos_z" step="0.1" value="<%= exitPosZ %>" class="form-control">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">保存仓库尺寸</button>
    </form>
  </div>

  <div class="card">
    <h2>货区配置</h2>
    <table>
      <thead>
        <tr>
          <th>货区编号</th>
          <th>名称</th>
          <th>行数</th>
          <th>列数</th>
          <th>层数</th>
          <th>格宽(m)</th>
          <th>格高(m)</th>
          <th>格深(m)</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody id="zoneTableBody">
        <% zones.forEach(function(zone) { %>
        <tr data-zone-code="<%= zone.code %>">
          <td><strong><%= zone.code %></strong></td>
          <td><%= zone.name %></td>
          <td><input type="number" class="zone-input" data-field="rows" value="<%= zone.rows %>" min="1"></td>
          <td><input type="number" class="zone-input" data-field="cols" value="<%= zone.cols %>" min="1"></td>
          <td><input type="number" class="zone-input" data-field="layers" value="<%= zone.layers %>" min="1"></td>
          <td><input type="number" class="zone-input" data-field="cell_width" value="<%= zone.cell_width %>" step="0.1" min="0.1"></td>
          <td><input type="number" class="zone-input" data-field="cell_height" value="<%= zone.cell_height %>" step="0.1" min="0.1"></td>
          <td><input type="number" class="zone-input" data-field="cell_depth" value="<%= zone.cell_depth %>" step="0.1" min="0.1"></td>
          <td><button type="button" class="btn btn-primary save-zone-btn">保存</button></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<script>
function showAlert(message, type) {
  var alertArea = document.getElementById('alertArea');
  var alertDiv = document.createElement('div');
  alertDiv.className = 'alert alert-' + type;
  alertDiv.textContent = message;
  alertArea.innerHTML = '';
  alertArea.appendChild(alertDiv);
  setTimeout(function() {
    if (alertDiv.parentNode) {
      alertDiv.remove();
    }
  }, 5000);
}

document.getElementById('warehouseSizeForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var width = document.getElementById('warehouse_width').value;
  var height = document.getElementById('warehouse_height').value;
  var depth = document.getElementById('warehouse_depth').value;
  var exitPosX = document.getElementById('exit_pos_x').value;
  var exitPosZ = document.getElementById('exit_pos_z').value;

  fetch('/api/config/warehouse-size', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      warehouse_width: width,
      warehouse_height: height,
      warehouse_depth: depth,
      exit_pos_x: exitPosX,
      exit_pos_z: exitPosZ
    })
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    showAlert('仓库尺寸已成功保存', 'success');
  })
  .catch(function(err) {
    showAlert('保存仓库尺寸失败: ' + err.message, 'error');
  });
});

document.querySelectorAll('.save-zone-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var row = btn.closest('tr');
    var zoneCode = row.getAttribute('data-zone-code');
    var inputs = row.querySelectorAll('.zone-input');

    var payload = {};
    payload.code = zoneCode;
    inputs.forEach(function(input) {
      payload[input.getAttribute('data-field')] = input.value;
    });

    fetch('/api/zones/' + zoneCode, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.hasConflict) {
        showAlert(zoneCode + '区 已保存，但注意：部分商品位置超越了新的货区边界，需要重新规划这些商品的位置。', 'error');
      } else {
        showAlert(zoneCode + '区 配置已成功保存', 'success');
      }
    })
    .catch(function(err) {
      showAlert('保存 ' + zoneCode + '区 配置失败: ' + err.message, 'error');
    });
  });
});
</script>

<%- include('partials/footer') %>
